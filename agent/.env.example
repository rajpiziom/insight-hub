# Supabase connection (same project as your News Intel Hub)
SUPABASE_URL=https://dhotjrblrzfkttpomlzl.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Your News Intel Hub login credentials (the account you use in the app — NOT your Economist login)
USER_EMAIL=your_email@example.com
USER_PASSWORD=your_password_here

# Browser type: 'edge' or 'chrome'
BROWSER_TYPE=edge

# Browser profile path (leave empty to auto-detect)
# Edge macOS:   ~/Library/Application Support/Microsoft Edge/Default
# Edge Windows: %LOCALAPPDATA%\Microsoft\Edge\User Data\Default
# Edge Linux:   ~/.config/microsoft-edge/Default
BROWSER_PROFILE_PATH=

# Sync interval in minutes (default: 60)
SYNC_INTERVAL_MINUTES=60

# Headless browser (true = invisible, false = watch it work)
HEADLESS=true
